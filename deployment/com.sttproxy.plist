<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sttproxy</string>

    <!-- 通过 wrapper 脚本启动，解决 launchd 极简 PATH 问题 -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/woodragon/Work/github/stt_proxy/scripts/run_server.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/woodragon/Work/github/stt_proxy</string>

    <!-- 开机自启 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 崩溃自动重启 -->
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/woodragon/Work/github/stt_proxy/logs/asr_service.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/woodragon/Work/github/stt_proxy/logs/asr_service_error.log</string>
</dict>
</plist>
