MODEL=mlx-community/Qwen3-ASR-1.7B-8bit
PORT=10241
HOST=0.0.0.0
HF_HUB_CACHE=./models
REPETITION_PENALTY=1.2
WESPEAKER_CACHE=./models/wespeaker
DIARIZE_THRESHOLD=0.75
MAX_UPLOAD_BYTES=524288000
# Python 解释器路径（留空则从 PATH 自动检测；launchd/非标准环境下建议设绝对路径）
PYTHON_BIN=
# 额外 PATH 前缀（留空则不修改 PATH；Homebrew ffmpeg 所需）
EXTRA_PATH=/opt/homebrew/bin:/usr/local/bin
